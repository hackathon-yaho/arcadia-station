# `scripts\run-real-ai.cmd`는 이 파일을 복사한 `.env`를 읽습니다.
# Spring Boot 단독 실행은 `.env`를 자동으로 읽지 않습니다.
# `.env`는 Git에서 무시되므로 실제 API 키는 그 파일에만 보관합니다.

# AI server
PORT=8081
AI_INTERNAL_API_KEY=arcadia-local-shared-key

# Real Gemini local mode
AI_ENABLED=true
AI_OFFLINE_MODE=false

# Online provider selection
AI_PROVIDER=gemini
# Leave blank on first run. run-real-ai.cmd asks once and stores it in .env.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI alternative
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1

# Generation and quota behavior
AI_CASE_GENERATION_TIMEOUT=180s
AI_CASE_GENERATION_MAX_RETRIES=1
AI_QUOTA_COOLDOWN=10m
